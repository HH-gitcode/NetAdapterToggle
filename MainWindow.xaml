<Window x:Class="NetAdapterToggle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NetAdapterToggle.Converters"
        Title="网络适配器一键开关 - NetAdapter Toggle"
        Width="860"
        Height="640"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <conv:InverseBoolConverter x:Key="InvertBool"/>
        <conv:AdapterStatusBrushConverter x:Key="BadgeBgBrush" Mode="BadgeBackground"/>
        <conv:AdapterStatusBrushConverter x:Key="BadgeFgBrush" Mode="BadgeForeground"/>
        <conv:AdapterStatusBrushConverter x:Key="IconBgBrush" Mode="IconBackground"/>
        <conv:AdapterStatusBrushConverter x:Key="IconFgBrush" Mode="IconForeground"/>
        <conv:AdapterStatusBrushConverter x:Key="ActionBgBrush" Mode="ActionBackground"/>
        <conv:AdapterStatusBrushConverter x:Key="ActionFgBrush" Mode="ActionForeground"/>
        <conv:AdapterStatusBrushConverter x:Key="ActionBorderBrush" Mode="ActionBorder"/>
    </Window.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="44"
                    Height="44"
                    CornerRadius="10"
                    Background="#2563EB"
                    Margin="0,0,12,0">
                <TextBlock Text="&#xE701;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="网络适配器一键开关"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="一键启用、禁用或重启 Windows 网络适配器 · 支持托盘快捷切换与桌面快捷方式"
                           FontSize="12.5"
                           Foreground="#64748B"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Admin Badge -->
                <Border x:Name="AdminBadge"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        Background="#DCFCE7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdminBadgeIcon"
                                   Text="&#xE73E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#15803D"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="AdminBadgeText"
                                   Text="已获管理员权限"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#15803D"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="ElevateButton"
                        Content="以管理员重启"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#F97316"
                        BorderBrush="#EA580C"
                        Foreground="White"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="ElevateButton_Click"/>

                <Button x:Name="RefreshButton"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        Foreground="#1E293B"
                        Click="RefreshButton_Click"
                        ToolTip="刷新列表 (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Search, Filter & Batch Actions Toolbar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12.5"
                                 VerticalContentAlignment="Center"
                                 Foreground="#0F172A"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Text="搜索名称、型号、IP..."
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchButton"
                                Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Foreground="#64748B"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,0"
                                Visibility="Collapsed"
                                Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>

                <!-- Filter Pills -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <RadioButton x:Name="FilterAll" Content="全部" IsChecked="True" Style="{StaticResource FilterPillStyle}" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterPhysical" Content="物理网卡" Style="{StaticResource FilterPillStyle}" Margin="4,0,0,0" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterEnabled" Content="已启用" Style="{StaticResource FilterPillStyle}" Margin="4,0,0,0" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterDisabled" Content="已禁用" Style="{StaticResource FilterPillStyle}" Margin="4,0,0,0" Checked="Filter_Changed"/>
                </StackPanel>

                <!-- Batch & System Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EnableAllButton"
                            Content="全部启用"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            Foreground="#047857"
                            Padding="10,5"
                            FontSize="12.5"
                            Margin="0,0,6,0"
                            ToolTip="启用当前列表中的所有物理网卡（或可见网卡）"
                            Click="EnableAllButton_Click"/>
                    <Button x:Name="DisableAllButton"
                            Content="全部禁用"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            Foreground="#B91C1C"
                            Padding="10,5"
                            FontSize="12.5"
                            Margin="0,0,6,0"
                            ToolTip="禁用当前列表中的所有已启用网卡"
                            Click="DisableAllButton_Click"/>
                    <Button x:Name="OpenNcpaButton"
                            Content="网络连接"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            Foreground="#334155"
                            Padding="10,5"
                            FontSize="12.5"
                            ToolTip="打开 Windows 网络连接控制面板 (ncpa.cpl)"
                            Click="OpenNcpaButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Adapter List -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl x:Name="AdaptersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Icon + Pin -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border Width="44"
                                                Height="44"
                                                CornerRadius="10"
                                                Background="{Binding ., Converter={StaticResource IconBgBrush}}">
                                            <TextBlock Text="{Binding KindGlyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="{Binding ., Converter={StaticResource IconFgBrush}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Middle: Adapter Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center"/>

                                            <Border Background="#F1F5F9"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           FontSize="11.5"
                                                           Foreground="#475569"/>
                                            </Border>

                                            <Border Background="{Binding ., Converter={StaticResource BadgeBgBrush}}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding ., Converter={StaticResource BadgeFgBrush}}"/>
                                            </Border>

                                            <!-- Pin toggle -->
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="6,0,0,0"
                                                    Padding="4,2"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="PinButton_Click"
                                                    ToolTip="置顶此适配器（同时显示在系统托盘菜单顶部）">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE734;"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE735;"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12.5"
                                                   Foreground="#475569"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,12,0"/>

                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0">
                                                <Run Text="IP: "/><Run Text="{Binding IpAddresses, Mode=OneWay}" Foreground="#334155"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0">
                                                <Run Text="速率: "/><Run Text="{Binding LinkSpeedText, Mode=OneWay}" Foreground="#334155"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Foreground="#64748B">
                                                <Run Text="MAC: "/><Run Text="{Binding MacAddress, Mode=OneWay}" Foreground="#334155"/>
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Right: Actions -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">

                                        <!-- Desktop Shortcut Button -->
                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                Foreground="#475569"
                                                Padding="9,7"
                                                Margin="0,0,6,0"
                                                Tag="{Binding}"
                                                Click="CreateShortcutButton_Click"
                                                ToolTip="在桌面创建一键切换快捷方式">
                                            <TextBlock Text="&#xE8A7;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"/>
                                        </Button>

                                        <!-- Restart Adapter Button -->
                                        <Button MinWidth="54"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                Foreground="#334155"
                                                Padding="12,6"
                                                Margin="0,0,8,0"
                                                IsEnabled="{Binding IsEnabled}"
                                                Tag="{Binding}"
                                                Click="RestartAdapterButton_Click"
                                                ToolTip="重启此网络适配器（先禁用再启用）">
                                            <TextBlock Text="重启" FontSize="12.5"/>
                                        </Button>

                                        <!-- Primary One-Click Toggle Button -->
                                        <Button Width="88"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Background="{Binding ., Converter={StaticResource ActionBgBrush}}"
                                                BorderBrush="{Binding ., Converter={StaticResource ActionBorderBrush}}"
                                                Foreground="{Binding ., Converter={StaticResource ActionFgBrush}}"
                                                FontWeight="SemiBold"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                Tag="{Binding}"
                                                Click="ToggleAdapterButton_Click">
                                            <TextBlock Text="{Binding ActionButtonText}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <Border x:Name="EmptyStatePanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="36"
                               Foreground="#CBD5E1"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateText"
                               Text="没有找到符合条件的网络适配器"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusBarText"
                       Grid.Column="0"
                       Text="正在加载网络适配器..."
                       FontSize="12.5"
                       Foreground="#475569"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <CheckBox x:Name="MinimizeToTrayCheckBox"
                      Grid.Column="1"
                      Content="关闭窗口时最小化到系统托盘"
                      FontSize="12.5"
                      Foreground="#475569"
                      VerticalAlignment="Center"
                      Checked="MinimizeToTrayCheckBox_Changed"
                      Unchecked="MinimizeToTrayCheckBox_Changed"/>
        </Grid>
    </Grid>
</Window>
